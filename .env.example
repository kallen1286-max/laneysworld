# Backend (Express server / Railway)
RESEND_API_KEY=re_your-resend-api-key
PORT=3001

# Postgres (Railway). The Railway web service references the Postgres service's
# DATABASE_URL via a variable reference, so this is normally set automatically
# in production. Only needed locally if you run `pnpm run db:migrate` against
# a local docker Postgres or the Railway DATABASE_PUBLIC_URL.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/laneysworld

# Frontend (Vite build-time)
# Base URL for the backend. Leave empty to call same-origin, or set to the
# Railway service URL for production builds.
VITE_API_URL=http://localhost:3001
